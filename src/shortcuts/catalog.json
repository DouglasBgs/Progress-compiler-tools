    ],
    "description": "Agrupamento com FIRST-OF e LAST-OF.",
    "body": [
      "FOR EACH ${1:tabela} NO-LOCK",
      "    BREAK BY $1.${2:campo}:",
      "    IF FIRST-OF($1.$2) THEN DO:",
      "        ${3:/* início do grupo */}",
      "    END.",
      "    $0",
      "    IF LAST-OF($1.$2) THEN DO:",
      "        /* fim do grupo */",
      "    END.",
      "END."
    ]
  },
  {
    "category": "Banco de dados: consultas",
