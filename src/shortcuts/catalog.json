    ],
    "description": "Busca sem bloqueio e verifica disponibilidade.",
    "body": [
      "FIND ${1:tabela}",
      "    WHERE $1.${2:campo} = ${3:valor}",
      "    NO-LOCK NO-ERROR.",
      "IF AVAILABLE $1 THEN DO:",
