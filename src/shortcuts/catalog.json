  {
    "category": "Banco de dados: escrita e transações",
    "prefixes": [
      "findlock"
    ],
    "description": "Busca para alteração sem aguardar bloqueios; trata indisponibilidade.",
    "body": [
      "FIND FIRST ${1:tabela}",
      "    WHERE $1.${2:campo} = ${3:valor}",
      "    EXCLUSIVE-LOCK NO-WAIT NO-ERROR.",
      "IF LOCKED $1 THEN DO:",
      "    ${4:/* registro bloqueado */}",
      "END.",
      "ELSE IF AVAILABLE $1 THEN DO:",
      "    $0",
      "END.",
      "ELSE DO:",
      "    /* registro não encontrado ou erro: consultar ERROR-STATUS */",
      "END."
    ]
  },
  {
    "category": "Banco de dados: escrita e transações",
    "prefixes": [
