    ],
    "description": "Temp-table com campo e índice.",
    "body": [
      "DEFINE TEMP-TABLE ${1:ttDados} NO-UNDO",
      "    FIELD ${2:id} AS ${3:INTEGER}",
      "    INDEX ${4:idxPrincipal} IS PRIMARY UNIQUE $2.",
      "$0"
    ]
  },
  {
    "category": "Temp-tables e datasets",
    "prefixes": [
      "defttlike"
    ],
