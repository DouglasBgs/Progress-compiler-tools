    ],
    "description": "Percorre registros de leitura.",
    "body": [
      "FOR EACH ${1:tabela} NO-LOCK",
      "    WHERE $1.${2:campo} = ${3:valor}:",
      "    $0",
      "END."
    ]
  },
  {
    "category": "Banco de dados: consultas",
    "prefixes": [
      "forfirst",
