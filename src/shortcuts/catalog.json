  {
    "category": "Queries",
    "prefixes": [
      "dynamicquery"
    ],
    "description": "Query dinâmica com limpeza do objeto em FINALLY.",
    "body": [
      "DEFINE VARIABLE ${1:hQuery} AS HANDLE NO-UNDO.",
      "DO ON ERROR UNDO, THROW:",
      "    CREATE QUERY $1.",
      "    $1:SET-BUFFERS(BUFFER ${2:tabela}:HANDLE).",
      "    $1:QUERY-PREPARE(\"FOR EACH $2 NO-LOCK\").",
      "    $1:QUERY-OPEN().",
      "    $1:GET-FIRST().",
      "    DO WHILE NOT $1:QUERY-OFF-END:",
      "        $0",
      "        $1:GET-NEXT().",
      "    END.",
      "    FINALLY:",
      "        IF VALID-HANDLE($1) THEN",
      "            DELETE OBJECT $1.",
      "    END FINALLY.",
      "END."
    ]
  },
