    ]
  },
  {
    "category": "Temp-tables e datasets",
    "prefixes": [
      "field"
    ],
    "description": "Campo dentro de DEFINE TEMP-TABLE; pontuação pertence à definição.",
    "body": [
      "FIELD ${1:campo} AS ${2:CHARACTER}",
      "$0"
    ]
  },
  {
    "category": "Temp-tables e datasets",
    "prefixes": [
      "index"
    ],
    "description": "Índice dentro de DEFINE TEMP-TABLE; ponto encerra a definição.",
    "body": [
      "INDEX ${1:idxPrincipal} IS PRIMARY UNIQUE ${2:campo}.",
      "$0"
    ]
  },
  {
    "category": "Temp-tables e datasets",
    "prefixes": [
      "emptytt",
