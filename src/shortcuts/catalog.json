    ],
    "description": "Primeiro registro segundo o índice; BY não escolhe o primeiro após ordenar.",
    "body": [
      "FOR FIRST ${1:tabela} NO-LOCK",
      "    WHERE $1.${2:campo} = ${3:valor}:",
