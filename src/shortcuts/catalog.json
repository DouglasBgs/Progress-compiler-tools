    ],
    "description": "Verifica disponibilidade do buffer.",
    "body": [
      "IF AVAILABLE ${1:tabela} THEN DO:",
      "    $0",
      "END."
    ]
  },
  {
    "category": "Banco de dados: consultas",
    "prefixes": [
      "canfind",
      "can-find"
    ],
    "description": "Testa existência sem carregar o registro no buffer.",
    "body": [
      "IF CAN-FIND(FIRST ${1:tabela}",
      "    WHERE $1.${2:campo} = ${3:valor}) THEN DO:",
      "    $0",
      "END."
    ]
  },
  {
    "category": "Banco de dados: escrita e transações",
    "prefixes": [
      "create"
    ],
    "description": "Cria registro no buffer informado.",
    "body": [
      "CREATE ${1:tabela}.",
      "ASSIGN",
      "    $1.${2:campo} = ${3:valor}.",
