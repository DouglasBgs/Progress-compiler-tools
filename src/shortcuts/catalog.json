    ]
  },
  {
    "category": "Queries",
    "prefixes": [
      "queryloop"
    ],
    "description": "Ciclo completo de query estática.",
    "body": [
      "DEFINE QUERY ${1:qDados} FOR ${2:tabela}.",
      "OPEN QUERY $1 FOR EACH $2 NO-LOCK.",
      "GET FIRST $1.",
      "DO WHILE NOT QUERY-OFF-END(\"$1\"):",
      "    $0",
      "    GET NEXT $1.",
      "END.",
      "CLOSE QUERY $1."
    ]
  },
  {
    "category": "Queries",
    "prefixes": [
      "getfirst",
      "get first"
    ],
    "description": "Primeiro registro da query.",
    "body": [
      "GET FIRST ${1:qDados}.",
      "$0"
    ]
  },
  {
    "category": "Queries",
    "prefixes": [
      "getnext",
      "get next"
    ],
    "description": "Próximo registro da query.",
    "body": [
      "GET NEXT ${1:qDados}.",
      "$0"
    ]
  },
