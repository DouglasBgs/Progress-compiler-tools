      "    EACH ${2:tabelaFilha} NO-LOCK",
      "    WHERE $2.${3:chave} = $1.$3:",
      "    $0",
      "END."
    ]
  },
  {
    "category": "Banco de dados: consultas",
    "prefixes": [
